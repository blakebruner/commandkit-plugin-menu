{
  "name": "commandkit-plugin-menu",
  "version": "0.2.1",
  "description": "Live, persistent Components V2 menus for CommandKit: pagination, static panels, push updates and restart-safe buttons.",
  "keywords": [
    "commandkit",
    "commandkit-plugin",
    "discord.js",
    "componentsv2",
    "menu",
    "pagination",
    "panel"
  ],
  "author": "Blake Bruner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blakebruner/commandkit-plugin-menu.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples/bot",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run --maxWorkers=3",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "commandkit": ">=1.2.0",
    "discord.js": "^14.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.1",
    "@types/node": "24",
    "commandkit": "1.2.6",
    "discord.js": "14.28.1",
    "ioredis": "5",
    "tsup": "^9.0.0",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
